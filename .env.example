# Car Clean Center – Environment Variables
# Скопируй в .env и заполни

# Flask
SECRET_KEY=your-super-secret-key-here-change-this
FLASK_ENV=production
FLASK_DEBUG=0

# Anthropic (для автогенерации блога)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Admin (защита endpoint /api/generate-blog)
ADMIN_SECRET=change-this-to-strong-secret-123

# URLs
BASE_URL=https://carcleancenter.net

# Database
DATABASE=blog.db
